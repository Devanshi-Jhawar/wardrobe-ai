# Copy to .env and adjust. All values have sane defaults for local dev.

# SQLite for zero-setup dev. Swap for Postgres later, e.g.:
# DATABASE_URL=postgresql+asyncpg://user:pass@localhost:5432/memory
DATABASE_URL=sqlite+aiosqlite:///./memory.db

# Don't suggest an item again until this many days after it was worn.
DEFAULT_AVOID_REPEAT_DAYS=3

# When true, recording a worn outfit also calls the wardrobe's
# POST /wardrobe/items/{id}/wear for each item (wear_count + last_worn_at).
SYNC_WARDROBE_WEAR=false
WARDROBE_SERVICE_URL=http://localhost:8001
