# Copy to .env and adjust. All values have sane defaults for local dev.

# SQLite for zero-setup dev. Swap for Postgres later, e.g.:
# DATABASE_URL=postgresql+asyncpg://user:pass@localhost:5432/wardrobe
DATABASE_URL=sqlite+aiosqlite:///./wardrobe.db

# Where uploaded images + thumbnails are written on local disk.
STORAGE_DIR=./storage

# Enrichment: when true, uploads call the vision + embedding services.
# Keep false until those services exist.
ENABLE_ENRICHMENT=false
VISION_SERVICE_URL=http://localhost:8002
EMBEDDING_SERVICE_URL=http://localhost:8003
