# Copy to .env and adjust. Defaults work out of the box (no model download).

# Which embedding backend to use:
#   color  -> lightweight, dependency-free color-histogram vectors (default)
#   clip   -> real semantic embeddings + text search (needs requirements-clip.txt)
EMBEDDING_BACKEND=color

# Shared output size. Both backends produce this many numbers (keep 512 so it
# matches the wardrobe service's embedding column and CLIP ViT-B/32).
EMBED_DIM=512

# CLIP settings (only used when EMBEDDING_BACKEND=clip)
CLIP_MODEL=ViT-B-32
CLIP_PRETRAINED=laion2b_s34b_b79k

# Max upload size in bytes (10 MB)
MAX_IMAGE_BYTES=10485760
