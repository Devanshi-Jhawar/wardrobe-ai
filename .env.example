# Copy to .env (same folder as docker-compose.yml) and fill in. .env is git-ignored.

# --- LLM planner (Groq). Leave empty to use the rules planner. ---
# Get a key at https://console.groq.com/keys
GROQ_API_KEY=
# Optional: pin a model, e.g. llama-3.3-70b-versatile. Empty = picked from your account's models.
LLM_MODEL=
# Optional: use Grok (xAI) instead: set XAI_API_KEY and LLM_PROVIDER=xai.
XAI_API_KEY=
LLM_PROVIDER=

# --- Postgres (runs in Docker; nothing to install) ---
POSTGRES_USER=wardrobe
POSTGRES_PASSWORD=change-me

# --- Embeddings: "color" (small, default) or "clip" (semantic + text search, ~2 GB image) ---
EMBEDDING_BACKEND=color
