# Copy to .env (same folder as docker-compose.yml) and fill in. .env is git-ignored.

# --- Grok (xAI) for the LLM planner. Leave empty to use the rules planner. ---
XAI_API_KEY=
# Optional: pin a model. Empty = the agent picks a fast Grok text model from your account.
XAI_MODEL=

# --- Postgres (runs in Docker; nothing to install) ---
POSTGRES_USER=wardrobe
POSTGRES_PASSWORD=change-me

# --- Embeddings: "color" (small, default) or "clip" (semantic + text search, ~2 GB image) ---
EMBEDDING_BACKEND=color
